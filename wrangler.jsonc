{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "die-unternehmensimmobilie-landingpage",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Statische Seite aus ./public; das Skript leitet nur die Domain ohne www auf www um
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "www.die-unternehmensimmobilie.de", "custom_domain": true },
    { "pattern": "die-unternehmensimmobilie.de", "custom_domain": true }
  ]
}
